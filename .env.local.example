# ─────────────────────────────────────────────────────────────────────────
# CineCrafter Productions — environment variables
# Copy this file to `.env.local` and fill in real values. Never commit .env.local.
# ─────────────────────────────────────────────────────────────────────────

# Contact form email delivery (Resend) — see src/app/api/contact/route.ts
# TODO: Sign up at https://resend.com, verify a sending domain, paste the key.
RESEND_API_KEY=

# Where inquiry notifications are delivered (your studio inbox).
CONTACT_NOTIFICATION_TO=hello@cinecrafter.example

# The verified "from" address Resend will send as.
CONTACT_NOTIFICATION_FROM=inquiries@cinecrafter.example

# ─────────────────────────────────────────────────────────────────────────
# Firebase (web config) — OPTIONAL overrides.
# These are NOT secrets: a Firebase web config ships to the browser by design.
# Sensible defaults for the CineCrafter project are baked into
# src/lib/firebase.ts, so you only need these to point at a different project.
# ─────────────────────────────────────────────────────────────────────────
# NEXT_PUBLIC_FIREBASE_API_KEY=
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=
# NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
# NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
# NEXT_PUBLIC_FIREBASE_APP_ID=
# NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# ─────────────────────────────────────────────────────────────────────────
# Gated direct contact details (server-only) — see src/lib/server/contact-secrets.ts
# ─────────────────────────────────────────────────────────────────────────
DIRECT_PHONE=
DIRECT_WHATSAPP=
DIRECT_EMAIL=
