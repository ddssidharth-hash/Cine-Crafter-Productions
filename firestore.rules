rules_version = '2';

// ═══════════════════════════════════════════════════════════════════════
// Firestore Security Rules — CineCrafter Productions
//
// The contact API writes inquiries to `inquiries`. We allow create-only
// (with basic field validation) and deny all reads/updates/deletes from the
// client — inquiries are read by the studio via the Firebase console or an
// admin/Cloud Function context (which bypasses these rules).
//
// Deploy:  firebase deploy --only firestore:rules
// ═══════════════════════════════════════════════════════════════════════
service cloud.firestore {
  match /databases/{database}/documents {

    match /inquiries/{inquiryId} {
      allow create: if
        request.resource.data.keys().hasAll(['name', 'email', 'projectType', 'message', 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 200
        && request.resource.data.email is string
        && request.resource.data.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$')
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 5000;

      // Inquiries are private — no public reading or tampering.
      allow read, update, delete: if false;
    }

    // Lock down everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
