rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'admin@cinecrafter.com';
    }

    // Public content collections
    match /projects/{projectId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /experimental/{projectId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /clients/{clientId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /about/{aboutId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /services/{serviceId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Contact form inquiries
    match /inquiries/{inquiryId} {
      allow create: if
        request.resource.data.keys().hasAll(['name', 'email', 'projectType', 'message', 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 200
        && request.resource.data.email is string
        && request.resource.data.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$')
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 5000;

      // Only the admin can read or delete inquiries
      allow read, delete: if isAdmin();
      allow update: if false;
    }

    // Lock down everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
